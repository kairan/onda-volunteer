generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventKind {
  PUBLIC
  PRIVATE
}

model Church {
  id              String     @id @default(cuid())
  name            String
  defaultTimezone String
  ministries      Ministry[]
  events          Event[]
}

model Ministry {
  id       String  @id @default(cuid())
  churchId String
  church   Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name     String
  events   Event[]
}

model Event {
  id          String    @id @default(cuid())
  kind        EventKind
  title       String
  startsAtUtc DateTime  @db.Timestamptz
  endsAtUtc   DateTime  @db.Timestamptz
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministryId  String?
  ministry    Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  @@index([churchId])
}
