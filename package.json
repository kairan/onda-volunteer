{
  "name": "onda-volunteer",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @onda/api test && pnpm --filter @onda/web test",
    "test:e2e:web": "PLAYWRIGHT_WITH_API=true pnpm --filter @onda/web test:e2e",
    "dev:api": "pnpm --filter @onda/api dev",
    "dev:web": "pnpm --filter @onda/web dev",
    "link:volunteer-auth": "pnpm --filter @onda/api link:volunteer-auth"
  },
  "packageManager": "pnpm@11.1.2"
}
