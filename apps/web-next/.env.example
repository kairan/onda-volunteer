VITE_API_URL=http://localhost:3000
# Default when nothing is stored in localStorage (onda:devVolunteerId). Override at /user-select without restart.
# Seed personas: seed-volunteer-demo (leader), seed-volunteer-hospitality (Hospitality volunteer only), seed-volunteer-admin, seed-volunteer-system-admin
VITE_DEMO_VOLUNTEER_ID=seed-volunteer-demo
VITE_DEMO_ROLE_ID=seed-role-greeter

# Supabase Auth (use legacy anon key eyJ... — NOT sb_secret_ or sb_publishable_ unless your SDK version supports it)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# When true (default), use X-Leader-Ministry-Id / X-Volunteer-Id if no Supabase session.
VITE_AUTH_USE_DEV_HEADERS=true
