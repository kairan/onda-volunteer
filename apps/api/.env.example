DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onda?schema=public"
WEB_ORIGIN="http://localhost:5173"

# Supabase project JWT secret (Settings → API → JWT Secret). Never commit real values.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Local-only: allow X-Leader-Ministry-Id / X-Volunteer-Id without Bearer tokens.
AUTH_ALLOW_DEV_HEADERS="true"

# Local-only: on first Bearer sign-in, link JWT sub to this seed volunteer when unassigned.
AUTH_AUTO_LINK_SEED_VOLUNTEER_ID="seed-volunteer-demo"
