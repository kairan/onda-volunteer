{
  "name": "onda-volunteer",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck:api": "pnpm --filter @onda/api typecheck",
    "typecheck:web-onda": "pnpm --filter @onda/web-onda typecheck",
    "test": "pnpm --filter @onda/api test && pnpm --filter @onda/web-onda test",
    "test:coverage": "pnpm --filter @onda/api test:coverage && pnpm --filter @onda/web-onda test:coverage",
    "test:e2e:web-onda": "PLAYWRIGHT_WITH_API=true pnpm --filter @onda/web-onda test:e2e",
    "dev:api": "pnpm --filter @onda/api dev",
    "dev:web-onda": "pnpm --filter @onda/web-onda dev",
    "link:volunteer-auth": "pnpm --filter @onda/api link:volunteer-auth"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.48.0"
  }
}
